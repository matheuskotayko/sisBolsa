            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teste.rate.limit@sisbolsa.com\",\n  \"senha\": \"senhaErrada\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 429', function () { pm.response.to.have.status(429); });",
                  "pm.test('mensagem de erro menciona bloqueio', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.mensagem).to.include('bloqueada');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
